# Groq API key for LLaMA-3.3-70b (routing, generation, fallback)
# Get a free key at console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key

# Optional: override the Groq chat model used for routing/generation/fallback
# (e.g. llama-3.1-8b-instant when the 70b free-tier quota is exhausted)
RAG_MODEL=llama-3.1-8b-instant
