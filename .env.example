# The app runs on whichever provider you paste a key for (selectable in the
# UI sidebar). Provide one or more of the three below.

# Groq — LLaMA-3.3-70b (routing, generation, fallback). Free key: console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key

# OpenAI — gpt-4o-mini. Free/paid key: platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini — gemini-2.0-flash. Free key: aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Groq chat model used for routing/generation/fallback
# (e.g. llama-3.1-8b-instant when the 70b free-tier quota is exhausted)
RAG_MODEL=llama-3.1-8b-instant
